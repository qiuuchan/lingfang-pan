{
  "name": "@lingfang/plugin-sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "lingfang-plugin": "src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./types/client-entry": "./src/types/client-entry.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cli:dev": "tsx src/cli/index.ts",
    "build": "node scripts/build-sdk.mjs && node scripts/build-adapt.mjs",
    "build:adapt": "node scripts/build-adapt.mjs",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@lingfang/contract": "workspace:*",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
      "lingfang-plugin": "dist/cli/index.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./manifest": {
        "types": "./dist/manifest/index.d.ts",
        "default": "./dist/manifest/index.js"
      },
      "./types/client-entry": {
        "types": "./dist/types/client-entry.d.ts",
        "default": "./dist/types/client-entry.js"
      }
    }
  }
}
