# 依赖
node_modules/
# 例外：桌面端内置 Node 运行时的 node_modules 必须入仓——
# pnpm/npm 等 shim(.cmd) 指向的真实入口(.cjs/.js)就在这里，缺失会让所有 Node 插件启动报 MODULE_NOT_FOUND。
# 注意：pnpm 包内部有 dist/ 和 dist/node_modules/ 子目录，必须同时反转 node_modules/、dist/、**/dist/ 三条通用规则，
# 否则 dist/pnpm.cjs（真正实现）和 dist/node_modules/（pnpm bundle 依赖）会被忽略。
!apps/desktop/runtimes/nodejs/node_modules/
!apps/desktop/runtimes/nodejs/node_modules/**
target/
dist/
**/dist/
# 例外（同上）：内置 Node 运行时 pnpm 包的 dist/ 不受 dist/ 与 **/dist/ 影响。
!apps/desktop/runtimes/nodejs/node_modules/pnpm/dist/
!apps/desktop/runtimes/nodejs/node_modules/pnpm/dist/**
# pnpm 包内 dist/node_modules/ 是 pnpm 自己 bundle 的运行时依赖，不是项目的 node_modules——
# 必须显式反转 node_modules/ 规则对它的命中，否则 git 会忽略这个子目录本身。
!apps/desktop/runtimes/nodejs/node_modules/pnpm/dist/node_modules/
!apps/desktop/runtimes/nodejs/node_modules/pnpm/dist/node_modules/**

# 桌面打包产物
apps/desktop/src-tauri/target/
release/

# 超过 Gitee 100MB 单文件限制的本地生成文件。
# Chromium chrome.dll 由仓库内 64 MiB 分片自动还原，完整文件不重复入仓。
apps/desktop/runtimes/chromium/ms-playwright/chromium-1228/chrome-win64/chrome.dll
# 下列文件是本地构建/分发产物，需单独传输：
#   - opencode.exe：本地代码助手二进制
#   - 大型第三方插件包：单独分发，不纳入版本控制
apps/desktop/opencode/bin/opencode.exe
plugins/moneyprinter-turbo.lfplugin
# 所有 .lfplugin 插件包均为本地构建/分发产物（超 Gitee 100MB 单文件限制），
# 单独传输不入仓。下方 git rm --cached 已把历史遗留的追踪移除。
plugins/*.lfplugin
# 插件二进制资源（内置字体/窗口图标）随 .lfplugin 本地分发，不入仓（同 .lfplugin 约定）。
# detail-poster/fonts/ 约 188MB；图标为小二进制。构建 .lfplugin 时需本地存在。
plugins/detail-poster/fonts/
plugins/detail-poster/app.ico
plugins/outfit-batch/favicon*.ico

# 后端运行时上传目录（admin 发布管理上传的安装包，运行时产物不入仓）。
# 生产持久化：docker-compose.collab.yml 挂 collab_downloads volume → /app/apps/collab-api/downloads
apps/collab-api/downloads/
# 后端运行时工单附件目录（用户提交的日志/图片，运行时产物不入仓）。
# 生产持久化：docker-compose.collab.yml 挂 collab_uploads volume → /app/apps/collab-api/uploads
apps/collab-api/uploads/

# 运行 / 测试产物
night_runs/
apps/collab-api/prisma/.generated/
*.log
# Playwright：失败截图/HTML 报告/产物不入仓；但 *-snapshots/ 基线要提交（测试断言依据）。
apps/desktop/test-results/
apps/desktop/playwright-report/
apps/desktop/playwright/.cache/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
**/__pycache__/
**/*.pyc
.pnpm-store-tmp/
.omo/
.pnpm-store/

# 本地态与密钥（永不入仓）
.env
.env.*
!.env.example
!.env.collab.example
**/secrets/

# Tauri 更新签名密钥（私钥永不入仓；公钥内嵌进 tauri.conf.json）
.tauri/
*.key

# Trellis 本机运行态
.trellis/.developer
.trellis/.current-task
.trellis/.runtime/
.trellis/.ralph-state.json
.trellis/.agents/
.trellis/.agent-log
.trellis/.session-id
.trellis/**/.plan-log
.trellis/**/*.tmp
.trellis/**/.backup-*/
.trellis/**/*.new

# 个人 AI 工具配置（仓库不为任何单一 AI 工具绑定）
.claude/
.cursor/    
.codex/
.opencode/
.zcode/
.agents/
.kimi-code/ 
pnpm-lock.yaml

