# 依赖
node_modules/
!apps/desktop/runtimes/nodejs/node_modules/
!apps/desktop/runtimes/nodejs/node_modules/**
target/
dist/
**/dist/

# 桌面打包产物
apps/desktop/src-tauri/target/
release/

# 大体积运行时二进制 / 第三方 .lfplugin（不入仓，超过 Gitee 100MB 单文件限制）
# 这些文件是本地构建/分发产物，需单独传输：
#   - FFmpeg 运行时：构建时 tauri.conf.json resources 从 ../runtimes 打包进安装包
#   - opencode.exe：本地代码助手二进制
#   - 大型第三方插件包：单独分发，不纳入版本控制
apps/desktop/runtimes/ffmpeg/ffmpeg.exe
apps/desktop/runtimes/ffmpeg/ffprobe.exe
apps/desktop/opencode/bin/opencode.exe
plugins/moneyprinter-turbo.lfplugin

# 后端运行时上传目录（admin 发布管理上传的安装包，运行时产物不入仓）。
# 生产持久化：docker-compose.collab.yml 挂 collab_downloads volume → /app/apps/collab-api/downloads
apps/collab-api/downloads/
# 后端运行时工单附件目录（用户提交的日志/图片，运行时产物不入仓）。
# 生产持久化：docker-compose.collab.yml 挂 collab_uploads volume → /app/apps/collab-api/uploads
apps/collab-api/uploads/

# 运行 / 测试产物
night_runs/
apps/collab-api/prisma/.generated/
*.log
# Playwright：失败截图/HTML 报告/产物不入仓；但 *-snapshots/ 基线要提交（测试断言依据）。
apps/desktop/test-results/
apps/desktop/playwright-report/
apps/desktop/playwright/.cache/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
**/__pycache__/
**/*.pyc
.pnpm-store-tmp/

# 本地态与密钥（永不入仓）
.env
.env.*
!.env.example
!.env.collab.example
**/secrets/

# Tauri 更新签名密钥（私钥永不入仓；公钥内嵌进 tauri.conf.json）
.tauri/
*.key

# Trellis 本机运行态
.trellis/.developer
.trellis/.current-task
.trellis/.runtime/
