/* ===================================================================
 * 注意：本文件已不再在运行时加载。
 *
 * 从 v0.3.0 起，主题由 plugins/rbflow-video/main.py 的 build_qss()
 * 动态生成（深色 DARK_COLORS / 亮色 LIGHT_COLORS 两套调色板 + f-string 模板），
 * 以支持顶栏「☀/☾」深色/亮色主题切换。详见 main.py 中 build_qss()。
 *
 * 下方保留原始暗色（Catppuccin Mocha）样式作为深色主题的可读参考；
 * 若要调整运行时样式，请改 main.py 的 build_qss()，而不是改本文件。
 * =================================================================== */

/* === RBFLow 视频生成插件 · 现代暗色主题（Catppuccin Mocha 系） === */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    font-size: 13px;
    color: #cdd6f4;
    outline: none;
}

/* ---- 主窗口 / 背景 ---- */
QMainWindow, QWidget#CentralWidget {
    background-color: #1e1e2e;
}

/* ---- 顶栏 banner ---- */
QFrame#TopBar {
    background-color: #181825;
    border-bottom: 1px solid #313244;
}

QLabel#AppTitle {
    font-size: 16px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#StatusBadge {
    color: #a6e3a1;
    font-size: 12px;
}

/* ---- 通用面板 / 卡片 ---- */
QFrame#Panel {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 10px;
}

/* ---- 三栏分割器（QSplitter）---- */
QSplitter {
    background-color: transparent;
}
QSplitter::handle:horizontal {
    background-color: #181825;
    width: 3px;
    margin: 8px 1px;
    border-radius: 1px;
}
QSplitter::handle:horizontal:hover {
    background-color: #89b4fa;
    width: 4px;
}

QLabel#PanelTitle {
    font-size: 14px;
    font-weight: 600;
    color: #89b4fa;
    padding: 2px 0px;
}

QLabel#SectionLabel {
    color: #a6adc8;
    font-size: 12px;
    font-weight: 500;
}

/* ---- 按钮 ---- */
QPushButton {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 14px;
    color: #cdd6f4;
}
QPushButton:hover {
    background-color: #45475a;
    border-color: #585b70;
}
QPushButton:pressed {
    background-color: #11111b;
}
QPushButton:disabled {
    color: #585b70;
    background-color: #1e1e2e;
    border-color: #313244;
}

QPushButton#PrimaryBtn {
    background-color: #89b4fa;
    border: none;
    color: #1e1e2e;
    font-weight: 600;
}
QPushButton#PrimaryBtn:hover {
    background-color: #b4befe;
}
QPushButton#PrimaryBtn:pressed {
    background-color: #74c7ec;
}
QPushButton#PrimaryBtn:disabled {
    background-color: #45475a;
    color: #585b70;
}

QPushButton#DangerBtn {
    background-color: transparent;
    border: 1px solid #f38ba8;
    color: #f38ba8;
}
QPushButton#DangerBtn:hover {
    background-color: #f38ba8;
    color: #1e1e2e;
}

QPushButton#IconBtn {
    background-color: transparent;
    border: none;
    padding: 4px 8px;
    color: #a6adc8;
    font-size: 14px;
}
QPushButton#IconBtn:hover {
    color: #cdd6f4;
    background-color: #313244;
    border-radius: 4px;
}

/* ---- 输入控件 ---- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 5px 8px;
    color: #cdd6f4;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}
QLineEdit:focus, QComboBox:focus {
    border-color: #89b4fa;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    selection-background-color: #313244;
    outline: none;
}

/* ---- 列表 ---- */
QListWidget {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}
QListWidget::item {
    border-radius: 6px;
    padding: 4px;
}
QListWidget::item:selected {
    background-color: #313244;
}
QListWidget::item:hover {
    background-color: #1e1e2e;
}

/* 图标模式（缩略图） */
QListWidget#ImageList, QListWidget#VideoList {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 8px;
}
QListWidget#ImageList::item, QListWidget#VideoList::item {
    border-radius: 8px;
    margin: 3px;
}

/* 任务列表 item：给选中态留 padding，避免选中背景覆盖卡片底部按钮 */
QListWidget#TaskList::item {
    padding: 3px;
    margin: 1px 0px;
    border-radius: 8px;
}
QListWidget#TaskList::item:selected {
    background-color: #313244;
}

/* ---- 进度条 ---- */
QProgressBar {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 4px;
    text-align: center;
    color: #cdd6f4;
    height: 16px;
}
QProgressBar::chunk {
    background-color: #89b4fa;
    border-radius: 3px;
}

/* ---- Tab ---- */
QTabWidget::pane {
    border: 1px solid #313244;
    border-radius: 6px;
    top: -1px;
}
QTabBar::tab {
    background-color: transparent;
    color: #6c7086;
    padding: 5px 12px;
    border: 1px solid transparent;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:selected {
    color: #cdd6f4;
    background-color: #181825;
    border-color: #313244;
}
QTabBar::tab:hover:!selected {
    color: #a6adc8;
}

/* ---- 滚动条 ---- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #313244;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #45475a;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #313244;
    border-radius: 5px;
    min-width: 30px;
}

/* ---- 任务卡片 ---- */
QFrame#TaskCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
}
QFrame#TaskCard:hover {
    border-color: #45475a;
}

QLabel#TaskFilename {
    color: #cdd6f4;
    font-weight: 500;
}
QLabel#TaskMeta {
    color: #6c7086;
    font-size: 11px;
}

/* ---- 复选框 ---- */
QCheckBox {
    spacing: 6px;
    color: #cdd6f4;
}
/* 注意：运行时勾选标记由 build_qss() 注入白色对勾 SVG，这里 image:none 会导致某些平台
   不显示勾——运行时样式已修复，本参考文件保留旧行为仅作历史对照。 */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #45475a;
    background-color: #11111b;
}
QCheckBox::indicator:checked {
    background-color: #89b4fa;
    border-color: #89b4fa;
}

/* ---- 分组框 ---- */
QGroupBox {
    border: 1px solid #313244;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
    color: #a6adc8;
    font-weight: 500;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* ---- 对话框 ---- */
QDialog {
    background-color: #181825;
}

/* ---- 提示标签 ---- */
QLabel#HintLabel {
    color: #6c7086;
    font-size: 11px;
}

QLabel#CreditLabel {
    color: #f9e2af;
    font-weight: 600;
}
