{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "灵坊工作台",
  "version": "0.0.6",
  "identifier": "com.lingfang.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm vite:build"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": {
      "../builtin-plugins": "builtin-plugins",
      "../runtimes": "runtimes"
    },
    "copyright": "© 2026 灵坊工作台",
    "shortDescription": "灵坊工作台 协作平台桌面客户端",
    "longDescription": "灵坊工作台 协作平台桌面客户端：AI 插件创建、团队协作、插件市场与钱包，支持本地代码助手与多种运行时插件。",
    "publisher": "灵坊工作台",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "灵坊工作台", "width": 1600, "height": 1000, "minWidth": 1024, "minHeight": 680, "decorations": false, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://*:* https://*:* ws://localhost:1420 http://localhost:1420; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self'; child-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0NDI2MjgyQ0U4MjE0RjcKUldUM0ZJTE9nbUpDSkcxMUoybjJtQm0xTzZVQm1FMFJFbmFqUWFTUlFYbGRSV2xFWVlMTGZMcUEK",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
