generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PlatformRole {
  NONE
  PLATFORM_ADMIN
}

enum TeamStatus {
  ACTIVE
  SUSPENDED
}

enum TeamRole {
  TEAM_ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvitationStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum PluginStatus {
  ENABLED
  DISABLED
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  displayName           String
  passwordHash          String
  status                UserStatus             @default(ACTIVE)
  platformRole          PlatformRole           @default(NONE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  memberships           TeamMembership[]
  applications          TeamAdminApplication[]
  reviewedApplications  TeamAdminApplication[] @relation("ApplicationReviewer")
  invitations           InvitationCode[]       @relation("InvitationCreator")
  balanceLedgers        BalanceLedger[]        @relation("LedgerActor")
  auditLogs             AuditLog[]             @relation("AuditActor")
}

model Team {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  status       TeamStatus       @default(ACTIVE)
  balanceCents Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  memberships  TeamMembership[]
  invitations  InvitationCode[]
  ledger       BalanceLedger[]
}

model TeamMembership {
  teamId   String
  userId   String
  role     TeamRole
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId, status])
}

model TeamAdminApplication {
  id           String            @id @default(uuid())
  userId       String
  teamName     String
  reason       String            @default("")
  status       ApplicationStatus @default(PENDING)
  reviewReason String            @default("")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([userId, status])
}

model InvitationCode {
  id                String           @id @default(uuid())
  teamId            String
  codeHash          String           @unique
  displayCodePrefix String
  createdById       String
  maxUses           Int              @default(1)
  usedCount         Int              @default(0)
  expiresAt         DateTime?
  status            InvitationStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  team              Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy         User             @relation("InvitationCreator", fields: [createdById], references: [id])

  @@index([teamId, status])
}

model BalanceLedger {
  id          String          @id @default(uuid())
  teamId      String
  amountCents Int
  direction   LedgerDirection
  reason      String
  actorUserId String?
  createdAt   DateTime        @default(now())
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor       User?           @relation("LedgerActor", fields: [actorUserId], references: [id])

  @@index([teamId, createdAt])
}

model Plugin {
  id          String       @id @default(uuid())
  name        String
  description String       @default("")
  status      PluginStatus @default(ENABLED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([actorUserId, createdAt])
}