generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PlatformRole {
  NONE
  PLATFORM_ADMIN
}

enum TeamStatus {
  ACTIVE
  SUSPENDED
}

enum TeamRole {
  TEAM_ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvitationStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum PluginStatus {
  ENABLED
  DISABLED
}

enum PluginRuntimeType {
  CLIENT
  CLOUD
  NODEJS
  PYTHON
}

enum PluginVisibility {
  PRIVATE
  TEAM
  PUBLIC
}

enum PluginReviewStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// 发布通道：STABLE 正式版（官网默认展示、桌面端默认检查），BETA 预览版（自愿接入）。
enum ReleaseChannel {
  STABLE
  BETA
}

// 发布状态：DRAFT 草稿（仅 Admin 可见）、PUBLISHED 已发布（公开可见）、ARCHIVED 已归档（历史保留不再展示为最新）。
enum ReleaseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// 产物平台：WINDOWS（.msi/.exe）、DARWIN（macOS .dmg/.app）、LINUX（.AppImage/.deb）。
enum AssetPlatform {
  WINDOWS
  DARWIN
  LINUX
}

// 产物架构：X86_64（Intel/AMD64）、AARCH64（ARM64，Apple Silicon / Win on ARM）、UNIVERSAL（macOS 通用二进制）。
enum AssetArch {
  X86_64
  AARCH64
  UNIVERSAL
}

// RBAC：角色作用域。PLATFORM 平台级（全局，管平台资源）；TEAM 团队级（归属某 team，管团队内资源）。
enum RoleScope {
  PLATFORM
  TEAM
}

// 计费/中转 · 渠道状态：ENABLED 启用可被路由 / DISABLED 软停用（保留历史日志，无物理 DELETE）。
enum ChannelStatus {
  ENABLED
  DISABLED
}

// 计费/中转 · 渠道上游协议：决定 relay 用哪个 SDK 与请求 shape 转发。
// OPENAI = /v1/chat/completions、/v1/images/generations（OpenAI 兼容）；
// ANTHROPIC = /v1/messages（Anthropic 原生协议）。
enum ChannelProtocol {
  OPENAI
  ANTHROPIC
}

// 计费/中转 · 资源池范围：SHARED 多团队共享 / DEDICATED 绑定单团队（teamId）。
enum PoolScope {
  SHARED
  DEDICATED
}

// 计费/中转 · 渠道类型：CHAT 聊天渠道（/v1/chat/completions、/v1/messages）/ IMAGE 生图渠道（/v1/images/generations、/v1/images/edits）。
// 两类分开管理；relay 据请求 capability 只路由到对应 kind 的渠道。
enum ChannelKind {
  CHAT
  IMAGE
}

// 计费/中转 · 计费单位。PER_TOKEN_INPUT/OUTPUT 按每 1M token 计（灵石/百万 token）；PER_CALL 按次固定；PER_IMAGE 按张固定。
enum PricingUnit {
  PER_TOKEN_INPUT
  PER_TOKEN_OUTPUT
  PER_CALL
  PER_IMAGE
}

// 计费/中转 · 渠道版本标签（FAST 快速 / PREMIUM 高级）。relay 据 model 哨兵匹配渠道 tier，多渠道轮询。
// 旧 ModelTierConfig（tier→固定底层模型）已移除：版本现由「打了 tier 标签的渠道池」决定，渠道内 models[] 轮询。
enum ModelTierId {
  FAST
  PREMIUM
}

// 计费/中转 · 平台 API Key 状态。ACTIVE 可用 / DISABLED 已吊销。
enum ApiKeyStatus {
  ACTIVE
  DISABLED
}

// RBAC：插件授权主体类型。USER 针对具体用户；ROLE 针对某角色下全部成员。
enum PluginGrantSubject {
  USER
  ROLE
}

// RBAC：插件授权效果。ALLOW 放行 / DENY 拒绝（deny 优先，user 级优先于 role 级，团队管理员默认放行）。
enum PluginGrantEffect {
  ALLOW
  DENY
}

model User {
  id                     String                 @id @default(uuid())
  email                  String                 @unique
  displayName            String
  passwordHash           String
  status                 UserStatus             @default(ACTIVE)
  platformRole           PlatformRole           @default(NONE)
  // RBAC：指向平台级角色（scope=PLATFORM）。过渡期与 platformRole 并存——
  // platformRole=PLATFORM_ADMIN 的用户回填到「系统平台管理员」角色；迁移完成后逐步移除枚举列。
  platformRoleId         String?
  // token 版本号：禁用/降级用户时自增，使已签发的旧 JWT 在 JwtAuthGuard 校验时失效（ADMIN-02/AUTH-01/XERR-02）。
  tokenVersion           Int                    @default(0)
  // 账户级密码重试锁定（组B）：连续密码错误累计计数，达阈值后置 lockedUntil 锁定。
  // 与 throttler（IP 级限流）正交：throttler 防单 IP 暴力扫描，本字段防定向爆破单账户。
  failedLoginAttempts    Int                    @default(0)
  lockedUntil            DateTime?
  // 邮箱验证时间：null=未验证。注册时自动发验证邮件，首版不阻断登录（session 响应带 emailVerified 供前端提示去验证）。
  emailVerified          DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  platformRoleRef        Role?                  @relation("UserPlatformRole", fields: [platformRoleId], references: [id], onDelete: SetNull)
  memberships            TeamMembership[]
  applications           TeamAdminApplication[]
  reviewedApplications   TeamAdminApplication[] @relation("ApplicationReviewer")
  invitations            InvitationCode[]       @relation("InvitationCreator")
  balanceLedgers         BalanceLedger[]        @relation("LedgerActor")
  authoredPlugins        Plugin[]               @relation("PluginAuthor")
  reviewedPlugins        Plugin[]               @relation("PluginReviewer")
  pluginReviews          PluginReview[]         @relation("PluginReviewReviewer")
  wallet                 Wallet?
  walletTransactions     WalletTransaction[]
  purchasesBuyer         Purchase[]             @relation("PurchaseBuyer")
  purchasesSeller        Purchase[]             @relation("PurchaseSeller")
  pluginRatings          PluginRating[]         @relation("PluginRater")
  auditLogs              AuditLog[]             @relation("AuditActor")
  platformSettingUpdates PlatformSetting[]      @relation("SettingUpdater")
  pluginGrantsCreated    PluginGrant[]          @relation("PluginGrantCreator")
  notifications          Notification[]
  // 计费/中转反向关系：用户作为灵石流水触发者、平台 API Key 创建者、调用日志发起者。
  creditLedgerActor      CreditLedger[]         @relation("CreditLedgerActor")
  createdApiKeys         PlatformApiKey[]       @relation("ApiKeyCreator")
  callLogs               LlmCallLog[]           @relation("CallLogCaller")

  @@index([platformRoleId])
}

model Team {
  id              String               @id @default(uuid())
  name            String
  slug            String               @unique
  status          TeamStatus           @default(ACTIVE)
  // 团队是否开放公开加入：true 时出现在「发现公开团队」列表，普通用户可一键直接加入（无需邀请码）。
  // 默认 false：团队管理员需在 TeamManage 主动开启（避免新建团队立刻被任意用户加入）。
  allowPublicJoin Boolean              @default(false)
  // 团队简介：公开团队发现页展示，帮助用户判断是否加入。
  description     String               @default("")
  balanceCents    Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  memberships     TeamMembership[]
  invitations     InvitationCode[]
  ledger          BalanceLedger[]
  plugins         Plugin[]
  installations   PluginInstallation[]
  // RBAC：团队级自定义角色（scope=TEAM，teamId 指向本团队）+ 团队插件授权记录。
  roles           Role[]
  pluginGrants    PluginGrant[]
  // 计费/中转反向关系：团队灵石账户、灵石流水、平台 API Key、调用日志。
  // 注：ChannelBinding.scopeId 为多态列（不建 FK），故 Team 不持有 channelBindings 反向关系。
  creditAccount   TeamCredit?
  creditLedger    CreditLedger[]
  apiKeys         PlatformApiKey[]
  callLogs        LlmCallLog[]
  pools           Pool[]

  // 公开团队发现查询索引：GET /api/teams/public 按 allowPublicJoin=true + status=ACTIVE 过滤。
  @@index([allowPublicJoin, status])
}

model TeamMembership {
  teamId     String
  userId     String
  role       TeamRole
  // RBAC：指向团队级角色（scope=TEAM）。过渡期与 role 枚举并存——
  // role=TEAM_ADMIN/MEMBER 的 membership 回填到对应系统角色；迁移完成后逐步移除枚举列。
  teamRoleId String?
  status     MembershipStatus @default(ACTIVE)
  joinedAt   DateTime         @default(now())
  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamRole   Role?            @relation("MembershipTeamRole", fields: [teamRoleId], references: [id], onDelete: SetNull)

  @@id([teamId, userId])
  @@index([userId, status])
  @@index([teamRoleId])
}

model TeamAdminApplication {
  id           String            @id @default(uuid())
  userId       String
  teamName     String
  reason       String            @default("")
  status       ApplicationStatus @default(PENDING)
  reviewReason String            @default("")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([userId, status])
}

model InvitationCode {
  id                String           @id @default(uuid())
  teamId            String
  codeHash          String           @unique
  displayCodePrefix String
  createdById       String
  maxUses           Int              @default(1)
  usedCount         Int              @default(0)
  expiresAt         DateTime?
  status            InvitationStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  team              Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy         User             @relation("InvitationCreator", fields: [createdById], references: [id])

  @@index([teamId, status])
}

model BalanceLedger {
  id          String          @id @default(uuid())
  teamId      String
  amountCents Int
  direction   LedgerDirection
  reason      String
  actorUserId String?
  createdAt   DateTime        @default(now())
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor       User?           @relation("LedgerActor", fields: [actorUserId], references: [id])

  @@index([teamId, createdAt])
}

model Plugin {
  id            String               @id @default(uuid())
  name          String
  description   String               @default("")
  version       String               @default("0.1.0")
  entry         String               @default("ui/index.html")
  runtimeType   PluginRuntimeType    @default(CLIENT)
  status        PluginStatus         @default(ENABLED)
  visibility    PluginVisibility     @default(TEAM)
  teamId        String?
  authorUserId  String?
  files         Json                 @default("[]")
  manifest      Json                 @default("{}")
  capabilities  Json                 @default("[]")
  contentHash   String               @default("")
  reviewStatus  PluginReviewStatus   @default(DRAFT)
  reviewReason  String               @default("")
  reviewedById  String?
  reviewedAt    DateTime?
  marketplace   Boolean              @default(false)
  priceCents    Int                  @default(0)
  installCount  Int                  @default(0)
  ratingCount   Int                  @default(0)
  ratingSum     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  team          Team?                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author        User?                @relation("PluginAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  reviewedBy    User?                @relation("PluginReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  installations PluginInstallation[]
  reviews       PluginReview[]
  purchases     Purchase[]
  ratings       PluginRating[]
  pluginGrants  PluginGrant[]

  @@unique([teamId, contentHash])
  @@index([teamId, status, visibility])
  @@index([authorUserId, createdAt])
  @@index([marketplace, reviewStatus, status])
  @@index([reviewStatus, createdAt])
}

model PluginInstallation {
  id            String       @id @default(uuid())
  pluginId      String
  teamId        String
  installedById String?
  version       String
  status        PluginStatus @default(ENABLED)
  installedAt   DateTime     @default(now())
  plugin        Plugin       @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([pluginId, teamId])
  @@index([teamId, status])
}

model PluginReview {
  id         String             @id @default(uuid())
  pluginId   String
  reviewerId String?
  status     PluginReviewStatus
  reason     String             @default("")
  createdAt  DateTime           @default(now())
  plugin     Plugin             @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  reviewer   User?              @relation("PluginReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([pluginId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  // 组E 性能：按 action 聚合的高频查询索引。adminGenerationStats/adminFinanceStats
  // 每次看板渲染都按 action（如 'llm_binding.key_decrypted'/'plugin.uploaded'）+ createdAt 范围 count 4 次，
  // 此前全表扫描；audit-view 按分类筛选同样依赖 action 前缀。复合 [action, createdAt] 覆盖两种过滤。
  @@index([action, createdAt])
}

// 平台设置（key/value 键值表，平台 Admin 维护）。
// key 为主键（如 platformName/logoUrl），value 为 String（富文本/URL/开关均以字符串存，由调用方按 key 解析）。
// description 为后台展示用说明（不参与业务逻辑，仅辅助 Admin 识别每项含义）。
// updatedById 记录最后修改人（FK User，onDelete SetNull，Admin 被禁用后设置仍保留但作者置空）。
model PlatformSetting {
  key         String   @id
  value       String   @default("")
  description String   @default("")
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id                 String          @id @default(uuid())
  userId             String
  amountCents        Int
  direction          LedgerDirection
  reason             String
  pluginId           String?
  counterpartyUserId String?
  createdAt          DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Purchase {
  id           String   @id @default(uuid())
  pluginId     String
  buyerUserId  String
  buyerTeamId  String
  sellerUserId String
  priceCents   Int
  createdAt    DateTime @default(now())
  plugin       Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  buyer        User     @relation("PurchaseBuyer", fields: [buyerUserId], references: [id])
  seller       User     @relation("PurchaseSeller", fields: [sellerUserId], references: [id])

  @@unique([pluginId, buyerUserId])
  @@index([buyerUserId])
  // 组E 性能：按买方团队聚合的高频查询索引。adminTeamDetail 用 buyerTeamId + createdAt desc
  // 拉最近 10 笔购买，此前 buyerTeamId 无索引走全表扫描；按租户的财务聚合同样受益。
  @@index([buyerTeamId, createdAt])
}

model PluginRating {
  id        String   @id @default(uuid())
  pluginId  String
  userId    String
  teamId    String
  score     Int
  comment   String   @default("")
  createdAt DateTime @default(now())
  plugin    Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  user      User     @relation("PluginRater", fields: [userId], references: [id])

  @@unique([pluginId, userId])
  @@index([pluginId])
}

// LLM provider 目录（平台级，平台 Admin 维护，应用发布时 seed 默认值）。
// provider 为 String（非 enum）：平台维护白名单（openai/anthropic/azure/deepseek/moonshot/qwen/custom），
// 见 dto/enums.ts LLM_PROVIDER。models 为 string[]（Json）。name 唯一（upsert seed 幂等）。
// 旧 BYOK 的 LlmGateway / TenantLlmBinding 已随计费/中转系统上线而移除：
// 渠道管理迁至 Channel（见本文件上方），用户侧无 apiKey 绑定（AI 调用走 relay，平台托管渠道）。

// 应用版本发布（平台级，平台 Admin 维护，官网展示 + 桌面端检查更新用）。
// version 为 semver 字符串（如 1.0.0），同 channel 内 (channel, version) 唯一。
// isLatest 由 publish 端点原子维护：发布时同 channel 其他版本 isLatest=false，仅一条 true。
// notes 为 markdown 文本（changelog），title 为版本标题（如「AI 生成器重构」）。
// publishedAt 在首次 publish 时落库（重发保持不变），用于官网时间线排序。
model Release {
  id          String         @id @default(uuid())
  version     String // semver，如 1.0.0
  channel     ReleaseChannel @default(STABLE)
  status      ReleaseStatus  @default(DRAFT)
  title       String         @default("") // 版本标题（展示用）
  notes       String         @default("") // markdown changelog
  isLatest    Boolean        @default(false) // 同 channel 内最新发布（publish 原子维护）
  publishedAt DateTime? // 首次发布时间，归档不清空（时间线排序）
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  assets      ReleaseAsset[]

  @@unique([channel, version])
  @@index([channel, status, isLatest])
  @@index([channel, status, publishedAt])
}

// 版本产物（一个版本下多个平台/架构的安装包登记）。
// url 为下载地址（外链，如 GitHub Release 直链或 CDN）；signature 为 Tauri updater 签名（base64，可选）。
// sizeBytes 用 Int（安装包 < 2GB，Int 上限 ~2.1GB 足够；避免 BigInt 的 JSON 序列化坑）。
// filename 为展示用文件名（如 LingFang_1.0.0_x64-setup.exe）。
// (releaseId, platform, arch) 唯一：同版本同平台同架构仅一个产物。
model ReleaseAsset {
  id        String        @id @default(uuid())
  releaseId String
  platform  AssetPlatform
  arch      AssetArch
  url       String // 下载直链（外链）
  filename  String        @default("") // 展示用文件名
  signature String        @default("") // Tauri updater base64 签名（可选，未接入 updater 时为空）
  sizeBytes Int? // 安装包字节大小（展示用，< 2GB）
  createdAt DateTime      @default(now())
  release   Release       @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, platform, arch])
  @@index([releaseId])
}

// 用户通知（用户级，不强制团队归属）。由内部业务事件触发 create（审核结果/收入到账等）。
// type 为 String（非 enum）：业务侧自由扩展通知类型，不锁死枚举（如 plugin_approved/purchase_sale/application_approved）。
// read 默认 false（未读），relatedType/relatedId 可选，指向触发该通知的业务实体（前端可据此跳转详情）。
// 索引 [userId, read] 支撑「未读列表」查询，[userId, createdAt] 支撑「按时间倒序」分页。
model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String   @default("")
  read        Boolean  @default(false)
  relatedType String?
  relatedId   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// RBAC：权限码注册表镜像。权限码本体由后端 permission-codes.ts 预定义（代码单一事实来源），
// 此表仅供 admin UI 展示/分组勾选用（seed 时从 permission-codes 全量 upsert）。code 为主键。
// scope 标识属平台级还是团队级。
// 模块→操作两级结构：group=moduleKey（向后兼容，如 "team.member"）；moduleLabel 为模块中文显示名（如「成员管理」）；
// moduleOrder 用于模块间稳定排序（同模块多权限共享同一值）。
model PermissionEntry {
  code        String    @id
  label       String
  scope       RoleScope
  group       String
  moduleKey   String
  moduleLabel String
  moduleOrder Int       @default(0)
  description String    @default("")
  createdAt   DateTime  @default(now())

  @@index([scope, group])
  @@index([scope, moduleKey])
}

// RBAC：权限组（可编辑分组显示名）。
// 管理员可对每个 moduleKey（= groupKey）自定义显示名，覆盖 PermissionEntry.moduleLabel。
// 仅覆盖显示名，不可新增/删除权限码本身。isSystem=true 为内置行（seed 写入，不可删）；isSystem=false 为管理员自定义覆盖行。
// 复合主键 (scope, groupKey)：同一 scope 下 groupKey 唯一。
model PermissionGroup {
  scope      RoleScope
  groupKey   String
  displayName String
  sortOrder  Int      @default(0)
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([scope, groupKey])
  @@index([scope, sortOrder])
}

// RBAC：自定义角色。
//  - scope=PLATFORM：平台级角色（全局，teamId=null），由平台管理员在 web 端管理，管平台资源。
//  - scope=TEAM：团队级角色（teamId 必填，归属某 team），由团队管理员在桌面端管理，管团队内资源。
// isSystem=true 为内置角色（系统平台管理员 / 系统团队管理员 / 系统成员），不可删除、不可改权限，仅可改显示名。
// permissions 为权限码数组（Prisma 原生数组列，值来自 PermissionEntry.code 白名单）。
model Role {
  id          String           @id @default(uuid())
  name        String
  code        String?
  scope       RoleScope
  teamId      String?
  isSystem    Boolean          @default(false)
  description String           @default("")
  permissions String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // 反向关系：挂此平台角色的用户、挂此团队角色的成员关系。
  // 注：PluginGrant.subjectId 是多态列（USER→userId/ROLE→roleId），不建 FK，
  // 故 Role 不持有 pluginGrants 反向关系；插件授权按 subjectKind + subjectId 应用层联查。
  users       User[]           @relation("UserPlatformRole")
  memberships TeamMembership[] @relation("MembershipTeamRole")

  // 同 scope+teamId 下角色名不重复。code 同 scope+teamId 下唯一（可选；null 各行独立）。
  // Postgres 中多列 unique 对 null 值各行独立（平台级 teamId=null 仍全局唯一）。
  @@unique([scope, teamId, name])
  @@unique([scope, teamId, code])
  @@index([scope, teamId])
}

// RBAC：团队级插件授权。团队管理员为团队内某插件按 user/role 设置 ALLOW/DENY。
// 授权解析（resolvePluginAccess）：deny 优先、user 级优先于 role 级、团队管理员默认放行。
// subjectKind=USER 时 subjectId=userId；subjectKind=ROLE 时 subjectId=teamRoleId。
// subjectId 为多态列（不建 FK）：USER 时指向 User，ROLE 时指向 Role，由应用层校验存在性 + 团队归属。
// createdBy 记录设置人（FK User，onDelete SetNull——管理员被禁用后授权记录保留但作者置空）。
model PluginGrant {
  id          String             @id @default(uuid())
  teamId      String
  pluginId    String
  subjectKind PluginGrantSubject
  subjectId   String
  effect      PluginGrantEffect
  createdBy   String?
  createdAt   DateTime           @default(now())
  team        Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  plugin      Plugin             @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  creator     User?              @relation("PluginGrantCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([teamId, pluginId, subjectKind, subjectId])
  @@index([teamId, pluginId])
}

// ============================================================
// 计费与模型中转（Relay + 灵石 Credit）—— 见 docs/billing-and-relay-design.md
// 设计要点：
//  - Channel 取代旧「单活跃 LlmGateway」，支持多渠道 + 范围路由 + 优先级/权重 + 故障转移。
//  - TeamCredit 独立于 Team.balanceCents（人民币·市场用）：本表是 AI 用量计费的虚拟货币「灵石」。
//  - 预扣 cap + 实算冲销：CreditLedger.source=reserve 记预扣，llm_consume/image_consume 记实扣，
//    refund 记上游失败回退；同一 callLogId 串联一次调用的全部账务变动。
//  - 上游真实 key 复用 credential-cipher（AES-256-GCM）加密存 Channel.encryptedUpstreamKey；
//    PlatformApiKey 只存 sha256(keyHash)，明文仅创建时返回一次。
//  - LlmCallLog 是计费/日志咽喉的唯一事实来源，多维索引覆盖管理端查询。
// ============================================================

// 资源池（Pool）：渠道的访问范围容器。
// scope=SHARED 时所有团队可用（teamId 留空）；scope=DEDICATED 时仅 teamId 指定团队可用。
// 团队 T 可用的池 = 全部 SHARED 池 + scope=DEDICATED 且 teamId=T 的池；relay 在这些池的渠道中按 kind+tier 轮询。
// 一个池可含多个渠道（聊天/生图混存）；渠道的 kind+tier 决定它服务哪类请求。
model Pool {
  id          String    @id @default(uuid())
  name        String    @unique // 展示名（如「默认池」「A 企业专用池」）
  scope       PoolScope @default(SHARED)
  teamId      String? // scope=DEDICATED 时必填（应用层校验团队存在 + 唯一性）
  description String    @default("")
  createdAt   DateTime  @default(now())
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  channels    Channel[]
}

// 上游渠道：归属一个资源池，有类型（聊天/生图）+ 版本标签（快速/高级）+ 多个可轮询模型。
// encryptedUpstreamKey: base64(iv||tag||ciphertext)（AES-256-GCM，复用 credential-cipher）。
// upstreamKeyHint: 脱敏串（非敏感，明文存库供列表展示，零解密）。
// models: string[] 该渠道可在上游调用的模型 id 列表（自定义多个，relay 在其中轮询）。
// kind: CHAT 聊天 / IMAGE 生图——决定路由到哪类请求；relay /chat/* 只走 CHAT 渠道，/images/* 只走 IMAGE 渠道。
// tier: FAST/PREMIUM——relay 据 model 哨兵匹配；同 kind+tier 的渠道轮询调用。
// protocol: OPENAI（/chat/completions + /images/generations）/ ANTHROPIC（/v1/messages）。
//           IMAGE 渠道仅支持 OPENAI 协议（Anthropic 无原生生图 API）。
model Channel {
  id                   String           @id @default(uuid())
  name                 String           @unique // 展示名（如「OpenAI 官方」）
  kind                 ChannelKind // CHAT 聊天 / IMAGE 生图
  tier                 ModelTierId // FAST 快速 / PREMIUM 高级
  protocol             ChannelProtocol
  provider             String // 平台白名单值（复用 LLM_PROVIDER：openai/anthropic/azure/…/custom）
  poolId               String
  baseUrl              String // 上游基址（规范化去尾斜杠，如 https://api.openai.com/v1）
  encryptedUpstreamKey String // base64(iv||tag||ciphertext)
  upstreamKeyHint      String           @default("") // 脱敏串（非敏感，明文存库）
  models               Json             @default("[]") // string[]，自定义多个上游模型，轮询调用
  status               ChannelStatus    @default(ENABLED)
  description          String           @default("")
  lastHealthAt         DateTime?
  lastHealthOk         Boolean?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  pool                 Pool             @relation(fields: [poolId], references: [id], onDelete: Cascade)
  callLogs             LlmCallLog[]

  @@index([poolId, status])
  @@index([kind, tier, status])
}

// 团队灵石账户（每团队一行）。balance 为灵石整数（独立于 Team.balanceCents 人民币分）。
// 用独立表而非 Team 列：灵石账务变更频繁（每次 AI 调用），独立表行锁更细、不与团队元数据更新争锁。
// 注：灵石流水 CreditLedger 直接关联 Team（共享 teamId），不经本表，故本表不持有 ledger 反向关系。
model TeamCredit {
  teamId    String   @id
  balance   Float    @default(0) // 灵石余额（Float：支持小数单价；>=0 由应用层条件扣款保证）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// 灵石流水（每次余额变动一行）。与 LlmCallLog 经 callLogId 串联（消费类必填，调整类为空）。
// source 取值：signup_bonus（注册赠送）/ llm_consume（AI 对话）/ image_consume（AI 生图）/
//             reserve（预扣）/ refund（上游失败回退）/ admin_adjust（管理员调整）/ purchase（兑换，预留）。
// amount 恒为正整数；direction 标识进账(CREDIT)/出账(DEBIT)。
model CreditLedger {
  id          String          @id @default(uuid())
  teamId      String
  amount      Float // 灵石（正数，支持小数）
  direction   LedgerDirection // 复用 CREDIT/DEBIT
  source      String // signup_bonus/llm_consume/image_consume/reserve/refund/admin_adjust/purchase
  reason      String          @default("") // 展示用说明
  actorUserId String? // 触发者（消费=调用者；调整=管理员）
  callLogId   String? // 关联 LlmCallLog（消费/预扣/回退类）
  createdAt   DateTime        @default(now())
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor       User?           @relation("CreditLedgerActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([source, createdAt])
}

// 模型定价（灵石）。每个「可计费能力 × 模型/动作 × 可选版本」一行，后台可配。
// capability: chat（对话）/ image（生图）/ action（固定动作，如创建插件会话）。
// model: 上游模型 id（chat/image）或自定义动作 key（action，如 create_plugin_session）。
// unit: 计费单位；pricePerUnit: 单价（灵石）。
//   PER_TOKEN_* 时 pricePerUnit = 每 1k token 多少灵石（整数避小数，tokens/1000 向上取整后乘单价）。
//   PER_CALL / PER_IMAGE 时 pricePerUnit = 每次/每张固定灵石数。
// tier: 可选——同模型不同版本不同价（null 表示该模型所有版本同价）。
model ModelPricing {
  id            String      @id @default(uuid())
  capability    String // chat / image / action
  model         String // 上游模型 id 或动作 key
  label         String      @default("") // 展示名
  unit          PricingUnit
  pricePerUnit  Float // 灵石（PER_TOKEN_* 时为每 1M token 价，支持小数）
  tier          ModelTierId? // 可选版本绑定
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([capability, model, tier])
  @@index([capability, enabled])
}

// 前台固定模型版本配置（快速版/高级版 → 底层上游模型 + 参数 + 调用策略）。
// tier 为主键（FAST/PREMIUM 各一行）。前台仅显 label；relay 据 chatModel/imageModel 路由到上游。
// extraParams 存放传给上游的附加参数（如 top_p、安全策略等），由后台统一配置，前台无感。
// ModelTierConfig 已移除：版本现由「打了 tier 标签的渠道池」决定，渠道内 models[] 轮询。
// 旧的 tier→固定底层模型映射不再需要。


// 平台 API Key（平台发放给团队，用于调 /api/relay/*）。
// 明文格式 lf_<32 hex>；keyHash=sha256(明文) 存库（凭据类不存密文/脱敏，只存哈希用于比对查找）。
// keyPrefix: 展示前缀（lf_ + 明文前 8 位），列表展示用（非敏感）。
// teamId: 归属团队（消费扣该团队灵石）。scopes: 能力白名单（chat/image/tier:fast/tier:premium）。
model PlatformApiKey {
  id          String        @id @default(uuid())
  teamId      String
  name        String        @default("") // 用户给的备注名
  keyPrefix   String // 展示前缀（lf_xxxxxxxx）
  keyHash     String        @unique // sha256(明文)
  scopes      String[]      @default([]) // 能力白名单：chat/image/tier:fast/tier:premium
  status      ApiKeyStatus  @default(ACTIVE)
  createdById String?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  callLogs    LlmCallLog[]

  @@index([teamId, status])
  @@index([keyHash])
}

// 调用日志（每次 relay 调用一条）。管理端多维度查询的事实来源。
// status: success / upstream_error / client_error / insufficient_balance / rate_limited。
// requestSummary: 脱敏元数据（model/temperature/size/n 等），**不存 prompt 全文**（PII + 体积）。
// credits: 本次实扣灵石（冲销后净额；失败回退为 0）。callLogId 串联 CreditLedger 账务。
model LlmCallLog {
  id             String        @id @default(uuid())
  teamId         String
  userId         String? // 发起者（API Key 调用时可能为空）
  apiKeyId       String?
  channelId      String?
  capability     String // chat / image / action
  tier           ModelTierId?
  model          String // 实际上游模型 id
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  images         Int           @default(0) // 生图张数
  durationMs     Int           @default(0)
  credits        Float         @default(0) // 本次实扣灵石（支持小数）
  status         String // success/upstream_error/client_error/insufficient_balance/rate_limited
  httpStatus     Int?
  errorCode      String?
  requestId      String? // x-request-id（排障串联）
  requestSummary Json          @default("{}") // 脱敏元数据（不含 prompt 全文）
  clientIp       String?
  createdAt      DateTime      @default(now())
  team           Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User?         @relation("CallLogCaller", fields: [userId], references: [id], onDelete: SetNull)
  apiKey         PlatformApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  channel        Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([capability, createdAt])
  @@index([status, createdAt])
  @@index([model, createdAt])
}
