// LLM provider 目录（平台级，平台 Admin 维护，应用发布时 seed 默认值）。
// provider 为 String（非 enum）：平台维护白名单（openai/anthropic/azure/deepseek/moonshot/qwen/custom），
// 见 dto/enums.ts LLM_PROVIDER。models 为 string[]（Json）。name 唯一（upsert seed 幂等）。
// 旧 BYOK 的 LlmGateway / TenantLlmBinding 已随计费/中转系统上线而移除：
// 渠道管理迁至 Channel（见本文件上方），用户侧无 apiKey 绑定（AI 调用走 relay，平台托管渠道）。

// 应用版本发布（平台级，平台 Admin 维护，官网展示 + 桌面端检查更新用）。
// version 为 semver 字符串（如 1.0.0），同 channel 内 (channel, version) 唯一。
// isLatest 由 publish 端点原子维护：发布时同 channel 其他版本 isLatest=false，仅一条 true。
// notes 为 markdown 文本（changelog），title 为版本标题（如「AI 生成器重构」）。
// publishedAt 在首次 publish 时落库（重发保持不变），用于官网时间线排序。
model Release {
  id          String         @id @default(uuid())
  version     String // semver，如 1.0.0
  channel     ReleaseChannel @default(STABLE)
  status      ReleaseStatus  @default(DRAFT)
  title       String         @default("") // 版本标题（展示用）
  notes       String         @default("") // markdown changelog
  isLatest    Boolean        @default(false) // 同 channel 内最新发布（publish 原子维护）
  publishedAt DateTime? // 首次发布时间，归档不清空（时间线排序）
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  assets      ReleaseAsset[]

  @@unique([channel, version])
  @@index([channel, status, isLatest])
  @@index([channel, status, publishedAt])
}

// 版本产物（一个版本下多个平台/架构的安装包登记）。
// url 为下载地址（外链，如 GitHub Release 直链或 CDN）。
// sha256 为安装包内容的 SHA-256 十六进制摘要（上传时后端自动计算），自制更新器下载后比对校验完整性。
// signature 为发布者 minisign 签名（.minisig 文本，含 untrusted comment / 签名 / trusted comment / 全局签名 4 行）。
//   上传安装包时若配置 LINGFANG_RELEASE_SIGNING_KEY 则对字节签名写入；桌面配置 LINGFANG_UPDATER_PUBKEY 后强制验签（fail-closed）。未配置签名密钥时恒空。
// sizeBytes 用 Int（安装包 < 2GB，Int 上限 ~2.1GB 足够；避免 BigInt 的 JSON 序列化坑）。
// filename 为展示用文件名（如 LingFang_1.0.0_x64-setup.exe）。
// (releaseId, platform, arch) 唯一：同版本同平台同架构仅一个产物。
model ReleaseAsset {
  id        String        @id @default(uuid())
  releaseId String
  platform  AssetPlatform
  arch      AssetArch
  url       String // 下载直链（外链）
  filename  String        @default("") // 展示用文件名
  sha256    String        @default("") // 安装包 SHA-256 十六进制摘要（上传时自动计算，更新器校验完整性）
  signature String        @default("") // 发布者 minisign 签名（.minisig 文本）：上传时若配置 LINGFANG_RELEASE_SIGNING_KEY 则对安装包字节签名写入；桌面配置 LINGFANG_UPDATER_PUBKEY 后强制验签（fail-closed）。未配置签名密钥时恒空。
  sizeBytes Int? // 安装包字节大小（展示用，< 2GB）
  createdAt DateTime      @default(now())
  release   Release       @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, platform, arch])
  @@index([releaseId])
}

// 用户通知（用户级，不强制团队归属）。由内部业务事件触发 create（审核结果/收入到账等）。
// type 为 String（非 enum）：业务侧自由扩展通知类型，不锁死枚举（如 plugin_approved/purchase_sale/application_approved）。
// read 默认 false（未读），relatedType/relatedId 可选，指向触发该通知的业务实体（前端可据此跳转详情）。
// 索引 [userId, read] 支撑「未读列表」查询，[userId, createdAt] 支撑「按时间倒序」分页。
model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String   @default("")
  read        Boolean  @default(false)
  relatedType String?
  relatedId   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// === 帮助与反馈工单 ===
// 工单主体：关联提交人 userId + 提交时当前团队 teamId（可空）。
// handlerUserId 为最近处理的管理员（弱引用，不建强关系；出参时按需 join displayName）。
// lastReplyAt 为最近一条消息时间，列表按此倒序（活跃工单置顶）。
model Ticket {
  id            String             @id @default(uuid())
  userId        String
  teamId        String?
  category      TicketCategory     @default(OTHER)
  title         String
  status        TicketStatus       @default(OPEN)
  priority      TicketPriority     @default(NORMAL)
  handlerUserId String?
  lastReplyAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation("TicketSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  team          Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messages      TicketMessage[]
  attachments   TicketAttachment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([teamId, status])
}

// 工单消息（多轮对话）：每条由 USER 或 ADMIN 发出，按 createdAt 升序构成时间线。
model TicketMessage {
  id           String             @id @default(uuid())
  ticketId     String
  authorUserId String
  authorRole   TicketAuthorRole
  body         String
  createdAt    DateTime           @default(now())
  ticket       Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments  TicketAttachment[]

  @@index([ticketId, createdAt])
}

// 工单附件（日志/图片）：存后端本地磁盘 uploads/tickets/<ticketId>/<storedName>，不公开静态托管。
// messageId=null 表示挂在工单首贴；否则挂在某条消息。下载经鉴权流式接口，仅提交人或管理员可读。
model TicketAttachment {
  id         String               @id @default(uuid())
  ticketId   String
  messageId  String?
  filename   String
  storedName String
  mimeType   String
  sizeBytes  Int
  kind       TicketAttachmentKind @default(OTHER)
  createdAt  DateTime             @default(now())
  ticket     Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    TicketMessage?       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
}

// RBAC：权限码注册表镜像。权限码本体由后端 permission-codes.ts 预定义（代码单一事实来源），
// 此表仅供 admin UI 展示/分组勾选用（seed 时从 permission-codes 全量 upsert）。code 为主键。
// scope 标识属平台级还是团队级。
// 模块→操作两级结构：group=moduleKey（向后兼容，如 "team.member"）；moduleLabel 为模块中文显示名（如「成员管理」）；
// moduleOrder 用于模块间稳定排序（同模块多权限共享同一值）。
model PermissionEntry {
  code        String    @id
  label       String
  scope       RoleScope
  group       String
  moduleKey   String
  moduleLabel String
  moduleOrder Int       @default(0)
  description String    @default("")
  createdAt   DateTime  @default(now())

  @@index([scope, group])
  @@index([scope, moduleKey])
}

// RBAC：权限组（可编辑分组显示名）。
// 管理员可对每个 moduleKey（= groupKey）自定义显示名，覆盖 PermissionEntry.moduleLabel。
// 仅覆盖显示名，不可新增/删除权限码本身。isSystem=true 为内置行（seed 写入，不可删）；isSystem=false 为管理员自定义覆盖行。
// 复合主键 (scope, groupKey)：同一 scope 下 groupKey 唯一。
model PermissionGroup {
  scope       RoleScope
  groupKey    String
  displayName String
  sortOrder   Int       @default(0)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([scope, groupKey])
  @@index([scope, sortOrder])
}

// RBAC：自定义角色。
//  - scope=PLATFORM：平台级角色（全局，teamId=null），由平台管理员在 web 端管理，管平台资源。
//  - scope=TEAM：团队级角色（teamId 必填，归属某 team），由团队管理员在桌面端管理，管团队内资源。
// isSystem=true 为内置角色（系统平台管理员 / 系统团队管理员 / 系统成员），不可删除、不可改权限，仅可改显示名。
// permissions 为权限码数组（Prisma 原生数组列，值来自 PermissionEntry.code 白名单）。
model Role {
  id          String           @id @default(uuid())
  name        String
  code        String?
  scope       RoleScope
  teamId      String?
  isSystem    Boolean          @default(false)
  description String           @default("")
  permissions String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // 反向关系：挂此平台角色的用户、挂此团队角色的成员关系。
  // 注：PluginGrant.subjectId 是多态列（USER→userId/ROLE→roleId），不建 FK，
  // 故 Role 不持有 pluginGrants 反向关系；插件授权按 subjectKind + subjectId 应用层联查。
  users       User[]           @relation("UserPlatformRole")
  memberships TeamMembership[] @relation("MembershipTeamRole")

  // 同 scope+teamId 下角色名不重复。code 同 scope+teamId 下唯一（可选；code=null 各行独立）。
  // 注意（P1-2 订正）：Postgres 默认 NULL != NULL，平台级角色 teamId=null 时这两个约束
  // 根本不参与唯一判定——同名 / 同 code 的平台角色可被重复插入，此前注释写反了。
  // 迁移 20260810000000_unique_nulls_not_distinct 把这两个索引重建为 NULLS NOT DISTINCT（PG15+），
  // 使 teamId=null 也参与比较；code 索引另加 WHERE "code" IS NOT NULL，保留「未填 code 的角色互不冲突」。
  // Prisma 7 的 PSL 无法表达该修饰符，索引名沿用默认名，改动只存在于迁移 SQL——
  // 后续 migrate dev 若重新生成这两个索引，务必手工补回修饰符，勿静默回退。
  @@unique([scope, teamId, name])
  @@unique([scope, teamId, code])
  @@index([scope, teamId])
}

// RBAC：团队级插件授权。团队管理员为团队内某插件按 user/role 设置 ALLOW/DENY。
// 授权解析（resolvePluginAccess）：deny 优先、user 级优先于 role 级、团队管理员默认放行。
// subjectKind=USER 时 subjectId=userId；subjectKind=ROLE 时 subjectId=teamRoleId。
// subjectId 为多态列（不建 FK）：USER 时指向 User，ROLE 时指向 Role，由应用层校验存在性 + 团队归属。
// createdBy 记录设置人（FK User，onDelete SetNull——管理员被禁用后授权记录保留但作者置空）。
model PluginGrant {
  id          String             @id @default(uuid())
  teamId      String
  packageId   String
  subjectKind PluginGrantSubject
  subjectId   String
  effect      PluginGrantEffect
  createdBy   String?
  createdAt   DateTime           @default(now())
  team        Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  package     PluginPackage      @relation("PluginPackageGrants", fields: [packageId], references: [id], onDelete: Cascade)
  creator     User?              @relation("PluginGrantCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([teamId, packageId, subjectKind, subjectId])
  @@index([teamId, packageId])
}

