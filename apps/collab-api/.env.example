PORT=19006
DATABASE_PROVIDER="postgresql"
DATABASE_URL="postgresql://lingfang:lingfang@localhost:5432/lingfang_collab?schema=public"
# MySQL 示例：
# DATABASE_PROVIDER="mysql"
# DATABASE_URL="mysql://lingfang:lingfang@localhost:3306/lingfang_collab"
CACHE_DRIVER="memory"
REDIS_URL=""
JWT_SECRET="dev-collab-change-me"
JWT_EXPIRES_IN="7d"
CORS_ALLOWED_ORIGINS="http://localhost:19005,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost"
# tauri://localhost = Tauri 2 dev 模式 webview origin；http(s)://tauri.localhost = Tauri 2 打包后 release origin（Windows 默认）。
# 官网落地页已与管理后台合并为 apps/collab-admin（同源 :19005）：
# 未登录显示官网落地页，登录后进入管理后台。无需额外的官网跨域配置。
# 生产部署时追加管理端域名（如 https://admin.example.com）。
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=true
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="ChangeMe123!"
PLATFORM_ADMIN_NAME="平台管理员"
# apiKey 加密密钥（64 位 hex，openssl rand -hex 32 生成；生产必设，不入 git）。
# 用于 AES-256-GCM 加密租户 LLM 绑定的 apiKey，密文存库支持跨电脑解密下发。
# 生产缺密钥服务启动 fail-fast；dev 缺密钥仅 warn，首次加解密时抛 llm_key_not_configured。
LLM_KEY_ENCRYPTION_KEY=""
# SMTP 邮件服务（找回密码用，占位式）。未配时邮件内容降级写 console.log（不报错，流程继续）。
# 配置优先级：管理后台「平台设置 → 邮件服务」> 此处 .env。
#   - 后台配置（PlatformSetting 表的 smtpUrl/smtpFrom/smtpUser/smtpPass）运行时热生效（不重启）。
#   - 此处 .env 仅作 fallback：后台未配时回退读 env，兼容老配置 / 首次启动初始化。
#   - 后台未配 smtpUser/smtpPass 时，凭据可内嵌在 SMTP_URL（如 smtps://user:pass@host:465）。
# 真实部署配置示例：SMTP_URL="smtps://user:pass@smtp.example.com:465" 或 smtp://host:587
# SMTP_FROM 可选，默认 "LingFang 平台 <no-reply@lingfang.local>"。
SMTP_URL=""
SMTP_FROM=""
# 密码重置链接基础 URL（找回密码邮件内的重置链接前缀）。
# 桌面端会把链接里的 reset_token 解析后弹「重置密码」对话框；生产配官网/客户端入口 URL。
PASSWORD_RESET_BASE_URL=""
# 邮箱验证链接基础 URL（注册后验证邮件内的验证链接前缀）。
# 桌面端 / 官网会把链接里的 verify_token 解析后调 /api/auth/verify-email 完成验证。
EMAIL_VERIFY_BASE_URL=""
# 管理端静态资源走国内 CDN 时在 collab-admin 构建时注入该变量。
VITE_CDN_BASE_URL=""
